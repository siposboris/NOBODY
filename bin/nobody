#!/usr/bin/env bash
# Python-free Nobody CLI launcher for the currently supported Rust subset.
set -Eeuo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
binary="${repo_root}/rust/target/debug/nobody"
if [[ -x "$binary" ]]; then
  exec "$binary" "$@"
fi
if ! command -v cargo >/dev/null 2>&1; then
  printf 'Nobody requires a compiled Rust binary or Cargo. No Python fallback is available.\n' >&2
  exit 2
fi
exec cargo run --locked --quiet --manifest-path "${repo_root}/rust/Cargo.toml" --bin nobody -- "$@"
