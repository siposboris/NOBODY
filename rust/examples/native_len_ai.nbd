fn identity(s: str): str { return s }
fn count(s: str): int { return len(s) }
let text = "Život ☸"
print(len(text), len(""), len("👩‍💻"))
print(len(text + "!"), len(identity(text)), count(text))
let copy = text
copy = copy + "✨"
print(copy, len(copy), count(copy))
for n in range(3) { print("step", n, len(copy)) }
